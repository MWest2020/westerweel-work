# Reveal.js-exports en andere standalone slide-decks zijn inline-zwaar;
# een eigen, lossere CSP zodat de site-brede hash-pinning ze niet breekt.
# Cloudflare Pages past álle matchende regels toe: zonder de "!"-regel krijgen
# /slides/* ook de site-brede CSP mee, en de browser handhaaft dan beide.
/slides/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'
